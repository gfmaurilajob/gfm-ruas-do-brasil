{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(pwsh -File ./.github/scripts/validate-structure.ps1)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.git/**)",
      "Edit(./docs/referencias/**)",
      "Edit(./ATTRIBUTION.md)",
      "Write(./docs/referencias/**)",
      "Write(./ATTRIBUTION.md)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(Remove-Item -Recurse*)"
    ]
  }
}
